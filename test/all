#!/bin/bash
# Static suite: model fixtures, contract pins, manifest validation, qmllint.
set -euo pipefail
cd "$(dirname "$0")/.."
OMARCHY_SOURCE="${OMARCHY_PATH:-/usr/share/omarchy}"
for t in test/*.test.js; do
  node "$t"
done
omarchy plugin validate .
qmllint -I "$OMARCHY_SOURCE/shell" PomodoroWidget.qml
echo "ok - pomodoro manifest and QML"
